{
  "name": "academic-website",
  "version": "6.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "assets:build": "node scripts/build-images.mjs",
    "map:europe": "node scripts/build-europe-map.mjs",
    "predev": "npm run assets:build",
    "dev": "next dev",
    "prebuild": "npm run assets:build && npm run check:calendar-footer",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "precheck": "npm run assets:build",
    "check": "npm run lint && npm run typecheck && npm run check:calendar-footer && npm run check:site-indexing",
    "check:calendar-footer": "node scripts/check-calendar-footer.mjs",
    "check:site-indexing": "node scripts/check-site-indexing.mjs",
    "audit:calendar-footer": "node scripts/audit-calendar-footer.mjs",
    "check:public-contract": "node --env-file=.env.local scripts/check-public-contract.mjs"
  },
  "dependencies": {
    "@bgonzalezbustamante/catholic-calendar": "0.1.0-beta.2",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@supabase/supabase-js": "2.118.0",
    "i18n-iso-countries": "7.14.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-simple-maps": "5.0.5",
    "sharp": "0.35.5",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
